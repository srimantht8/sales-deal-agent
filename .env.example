# AWS (used for both Bedrock LLM and S3 document store)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
LLM_PROVIDER=bedrock  # "bedrock" | "openai" | "anthropic" | "azure" | "vertex"

# S3 Document Store
S3_BUCKET_NAME=sales-deal-agent-docs  # created by `make setup-s3`
DOCUMENT_SOURCE=local  # or "s3" to load from S3 bucket

# LLM — Direct API providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Azure OpenAI (for multi-cloud comparison)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# GCP Vertex AI (for multi-cloud comparison)
# GCP_PROJECT_ID=your-gcp-project
# GCP_LOCATION=us-central1
# VERTEX_MODEL_ID=gemini-2.0-flash

# Web Search
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily  # or "duckduckgo" for zero-config fallback

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sales-deal-acceleration-agent
